/*
 * ProSIFT -- nextflow.config
 * Infrastructure configuration. Scientific parameters live in params.yml.
 */

// Default params (overridden at runtime via --param value)
params {
    // Input
    samplesheet         = null   // path to samplesheet.csv (one row per run)

    // Output
    outdir              = 'results'
    tracedir            = "${params.outdir}/pipeline_info"

    // Resource limits (overridden per-process in conf/base.config)
    max_cpus            = 4
    max_memory          = '16.GB'
    max_time            = '24.h'
}

// Load base resource config
includeConfig 'conf/base.config'

// Execution profiles
profiles {

    // Local execution (development/testing on macOS)
    local {
        process.executor = 'local'
    }

    // Minimal smoke test on the shipped example.
    //
    //   nextflow run main.nf -profile test,conda
    //
    // [FOLLOW-UP NEEDED] THIS PROFILE DOES NOT CURRENTLY WORK. The example is
    // 40 proteins and bin/filter_proteins.py:583 requires at least 50, so the
    // run dies at Module 01 step 2. It is also NOT offline: UNIPROT_MAPPING is
    // not gated by databases.enabled and reaches UniProt + Ensembl BioMart.
    // ground_truth.csv is wrong by one protein. This profile has never been
    // executed (Nextflow is not installed on the dev machine).
    // See assets/examples/KNOWN_ISSUES.md before relying on any of this.
    //
    // 40 proteins x 6 samples (3 CTRL vs 3 TREAT) with planted effects,
    // generated by assets/examples/generate_examples.py.
    test {
        params.samplesheet = "${projectDir}/assets/examples/minimal/samplesheet.csv"
        params.outdir      = 'results_test'
        params.max_cpus    = 2
        params.max_memory  = '4.GB'
        params.max_time    = '1.h'
    }

    // HPC cluster: anthill.sdsu.edu (Torque 6; Nextflow 'pbs' executor)
    // 'pbs' is Nextflow's Torque executor: it writes '-l nodes=1:ppn=N' (cpus > 1),
    // '-l mem=', and '-l walltime=' itself, and decodes Torque's 'C' job state.
    // Do not use 'pbspro' (PBS Pro 'select=' syntax) or a '-l' clusterOptions:
    // a '-l' clusterOption makes Nextflow drop the cpus/memory requests.
    pbs {
        process.executor   = 'pbs'
        process.queue      = 'batch'    // anthill 'qstat -Q' lists only 'batch' (checked 2026-09-30)
        executor {
            queueSize      = 20
            submitRateLimit = '10/1min'
        }
    }

    // Conda environment
    // Nextflow's conda activation machinery requires conda shell hooks that
    // are not available in non-interactive subprocesses. Workaround: prepend
    // the prosift env bin to PATH via beforeScript.
    //
    // Uses 'conda info --base' to find the conda prefix dynamically, so the
    // same config works on both macOS (local) and the cluster without edits.
    // Requires: (1) conda is on PATH, (2) env named 'prosift' exists.
    // Create the env first: conda env create -f environment.yml
    conda {
        // Prepend prosift env bin to PATH, and set R_HOME + DYLD_LIBRARY_PATH
        // so that rpy2 (used by Module 04 differential_abundance.py) can locate
        // libR.dylib at runtime. Without R_HOME, rpy2 segfaults on macOS even
        // when R is on PATH.
        process.beforeScript = '''
            export PROSIFT_BASE="$(conda info --base)/envs/prosift"
            export PATH="${PROSIFT_BASE}/bin:${PATH}"
            export R_HOME="${PROSIFT_BASE}/lib/R"
            export DYLD_LIBRARY_PATH="${PROSIFT_BASE}/lib/R/lib:${DYLD_LIBRARY_PATH:-}"
        '''
    }

    // Singularity container (Phase 1+)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

}

// Execution tracing and reporting
// overwrite = true so a re-run (or -resume) does not abort with
// FileAlreadyExistsException when reports from a prior run already exist.
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace.txt"
}
